{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["vitest/globals", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "~/*": ["./*"],
      "@oods/*": ["./packages/*/src"],
      "@oods/provenance": ["./configs/provenance.placeholder.json"],
      "../../../../packages/*": ["./packages/*"]
    }
  },
  "include": [
    "src/**/*",
    "scripts/**/*.ts",
    "scripts/**/*.tsx",
    "packages/viz-core/src/vega-format.d.ts",
    "examples/**/*.ts",
    "examples/**/*.tsx"
  ],
  "exclude": [
    "node_modules", "dist", "**/*.test.ts",
    // Adapter sources compile inside a shadcn project and are proven in both shadcn fixtures.
    "scripts/runtime/shadcn/**",
    "scripts/product-reality/s215-html-measure.ts", // retained producer of sprint-215 receipts
    "scripts/product-reality/s217-chart-brand-proof.ts", // retained producer of sprint-217 receipts
    "scripts/product-reality/s218-older-carries.ts", // retained producer of sprint-218 receipts
    "scripts/product-reality/s219-currency-help-proof.ts", // retained producer of sprint-219 receipts
    "scripts/product-reality/s226-m01-screens.ts" // retained producer of sprint-226 receipts
  ]
}

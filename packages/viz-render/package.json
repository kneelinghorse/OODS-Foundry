{
  "name": "@oods/viz-render",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic Vega-Lite and ECharts SVG rendering runtime for the OODS design system. Produces byte-stable headless SVG without jsdom or native canvas while @oods/viz-core remains the zero-runtime spec transformer.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Design System Team",
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "visualization",
    "vega-lite",
    "vega",
    "svg",
    "render",
    "design-system",
    "accessibility"
  ],
  "scripts": {
    "build": "rimraf dist && tsup --config tsup.config.ts",
    "clean": "rimraf dist",
    "prepack": "pnpm run build",
    "test": "pnpm run build && vitest run"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "vega": "^6.2.0",
    "vega-lite": "^6.4.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "packageManager": "pnpm@9.12.2"
}

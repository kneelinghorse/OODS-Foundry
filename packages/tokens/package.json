{
  "name": "@oods/tokens",
  "version": "0.10.2",
  "description": "Design tokens for OODS Foundry: CSS variables and JavaScript values for its brands in light, dark and high-contrast themes.",
  "homepage": "https://oods-foundry.com/",
  "bugs": {
    "url": "https://github.com/kneelinghorse/OODS-Foundry/issues"
  },
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "oods",
    "oods-foundry",
    "design-tokens",
    "dtcg",
    "css-variables",
    "design-system"
  ],
  "scripts": {
    "build": "rimraf dist && node ./scripts/build.mjs && node ./scripts/build-entry.mjs",
    "clean": "rimraf dist",
    "lint": "node ../../tools/token-lint/index.mjs ./src",
    "prepack": "pnpm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": {
        "import": "./dist/index.cjs",
        "require": "./dist/index.cjs"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./css": {
      "import": "./dist/css/tokens.css",
      "require": "./dist/css/tokens.css",
      "default": "./dist/css/tokens.css"
    },
    "./brands": {
      "types": "./dist/brands.d.ts",
      "import": "./dist/brands.js",
      "require": "./dist/brands.cjs",
      "default": "./dist/brands.js"
    },
    "./recipe": {
      "types": "./dist/recipe.d.ts",
      "import": "./dist/recipe.js",
      "default": "./dist/recipe.js"
    },
    "./tailwind": {
      "import": "./dist/tailwind/tokens.json",
      "require": "./dist/tailwind/tokens.json",
      "default": "./dist/tailwind/tokens.json"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "packageManager": "pnpm@9.12.2",
  "devDependencies": {
    "rimraf": "^5.0.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kneelinghorse/OODS-Foundry.git",
    "directory": "packages/tokens"
  }
}

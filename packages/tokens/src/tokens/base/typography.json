{
  "ref": {
    "typography": {
      "families": {
        "sans": {
          "$type": "fontFamily",
          "$value": "Geist, ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica Neue, Arial, sans-serif",
          "$description": "The default brand's sans (brand A): Geist, which ships with these tokens (SIL OFL 1.1), then system fallbacks. A brand's own family is --sys-font-sans."
        },
        "mono": {
          "$type": "fontFamily",
          "$value": "Geist Mono, ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, Liberation Mono, Courier New, monospace",
          "$description": "The paired mono: Geist Mono, which ships with these tokens (SIL OFL 1.1), then system fallbacks."
        }
      },
      "weights": {
        "regular": {
          "$type": "number",
          "$value": 400,
          "$description": "Standard reading weight."
        },
        "medium": {
          "$type": "number",
          "$value": 500,
          "$description": "Controls, labels and captions."
        },
        "semibold": {
          "$type": "number",
          "$value": 600,
          "$description": "Headings."
        },
        "bold": {
          "$type": "number",
          "$value": 700,
          "$description": "Bold weight for hero headings and emphasis."
        },
        "light": {
          "$type": "number",
          "$value": 300,
          "$description": "Light weight for editorial display headings."
        }
      },
      "sizes": {
        "xs": {
          "$type": "dimension",
          "$value": "12px",
          "$description": "Caption scale."
        },
        "sm": {
          "$type": "dimension",
          "$value": "14px",
          "$description": "Compact body/label scale."
        },
        "md": {
          "$type": "dimension",
          "$value": "16px",
          "$description": "Default reading scale."
        },
        "lg": {
          "$type": "dimension",
          "$value": "18px",
          "$description": "Small heading scale (heading-md)."
        },
        "xl": {
          "$type": "dimension",
          "$value": "24px",
          "$description": "Section heading scale (heading-lg)."
        },
        "xxl": {
          "$type": "dimension",
          "$value": "30px",
          "$description": "Page title scale (heading-xl)."
        },
        "display-sm": {
          "$type": "dimension",
          "$value": "48px",
          "$description": "Small display heading \u2014 section heroes and feature titles."
        },
        "display-md": {
          "$type": "dimension",
          "$value": "64px",
          "$description": "Medium display heading \u2014 page hero titles."
        },
        "display-lg": {
          "$type": "dimension",
          "$value": "80px",
          "$description": "Large display heading \u2014 homepage hero statement."
        },
        "code": {
          "$type": "dimension",
          "$value": "13px",
          "$description": "Monospace scale for code, identifiers and figures."
        }
      },
      "line-height": {
        "tight": {
          "$type": "dimension",
          "$value": "120%",
          "$description": "Tight rhythm for headlines and compact contexts."
        },
        "standard": {
          "$type": "dimension",
          "$value": "140%",
          "$description": "Baseline rhythm for UI text."
        },
        "relaxed": {
          "$type": "dimension",
          "$value": "150%",
          "$description": "Relaxed rhythm for dense reading."
        },
        "loose": {
          "$type": "dimension",
          "$value": "160%",
          "$description": "Loose rhythm for long-form detail views."
        }
      },
      "letter-spacing": {
        "tight": {
          "$type": "dimension",
          "$value": "-0.01em",
          "$description": "Tracking for small headings (heading-md)."
        },
        "default": {
          "$type": "dimension",
          "$value": "0em",
          "$description": "Neutral tracking for body copy."
        },
        "wide": {
          "$type": "dimension",
          "$value": "0.08em",
          "$description": "Wide tracking for uppercase captions."
        },
        "display": {
          "$type": "dimension",
          "$value": "-0.05em",
          "$description": "Tracking for display headings."
        },
        "heading-xl": {
          "$type": "dimension",
          "$value": "-0.025em",
          "$description": "Tracking for the page title."
        },
        "heading-lg": {
          "$type": "dimension",
          "$value": "-0.02em",
          "$description": "Tracking for section headings."
        }
      }
    }
  },
  "text": {
    "line-height": {
      "tight": {
        "$type": "dimension",
        "$value": "{ref.typography.line-height.tight}",
        "$description": "Tight rhythm for condensed contexts."
      },
      "standard": {
        "$type": "dimension",
        "$value": "{ref.typography.line-height.standard}",
        "$description": "Standard rhythm for general UI copy."
      },
      "relaxed": {
        "$type": "dimension",
        "$value": "{ref.typography.line-height.relaxed}",
        "$description": "Relaxed rhythm for supporting text."
      },
      "loose": {
        "$type": "dimension",
        "$value": "{ref.typography.line-height.loose}",
        "$description": "Loose rhythm for long-form reading."
      }
    },
    "letter-spacing": {
      "tight": {
        "$type": "dimension",
        "$value": "{ref.typography.letter-spacing.tight}",
        "$description": "Tight tracking for display headings."
      },
      "default": {
        "$type": "dimension",
        "$value": "{ref.typography.letter-spacing.default}",
        "$description": "Neutral tracking."
      },
      "wide": {
        "$type": "dimension",
        "$value": "{ref.typography.letter-spacing.wide}",
        "$description": "Wide tracking for uppercase or caption text."
      }
    },
    "scale": {
      "display-lg": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{theme.font.sans}",
          "fontWeight": "{ref.typography.weights.semibold}",
          "fontSize": "{ref.typography.sizes.display-lg}",
          "lineHeight": "105%",
          "letterSpacing": "{ref.typography.letter-spacing.display}"
        },
        "$description": "Display, 80/1.05: the largest hero statement."
      },
      "display-md": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{theme.font.sans}",
          "fontWeight": "{ref.typography.weights.semibold}",
          "fontSize": "{ref.typography.sizes.display-md}",
          "lineHeight": "105%",
          "letterSpacing": "{ref.typography.letter-spacing.display}"
        },
        "$description": "Display, 64/1.05: a page hero title."
      },
      "display-sm": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{theme.font.sans}",
          "fontWeight": "{ref.typography.weights.semibold}",
          "fontSize": "{ref.typography.sizes.display-sm}",
          "lineHeight": "110%",
          "letterSpacing": "{ref.typography.letter-spacing.display}"
        },
        "$description": "Display, 48/1.1: a section hero or feature title."
      },
      "heading-xl": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{theme.font.sans}",
          "fontWeight": "{ref.typography.weights.semibold}",
          "fontSize": "{ref.typography.sizes.xxl}",
          "lineHeight": "36px",
          "letterSpacing": "{ref.typography.letter-spacing.heading-xl}"
        },
        "$description": "Page title, 30/36."
      },
      "heading-lg": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{theme.font.sans}",
          "fontWeight": "{ref.typography.weights.semibold}",
          "fontSize": "{ref.typography.sizes.xl}",
          "lineHeight": "32px",
          "letterSpacing": "{ref.typography.letter-spacing.heading-lg}"
        },
        "$description": "Section heading, 24/32."
      },
      "heading-md": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{theme.font.sans}",
          "fontWeight": "{ref.typography.weights.semibold}",
          "fontSize": "{ref.typography.sizes.lg}",
          "lineHeight": "24px",
          "letterSpacing": "{ref.typography.letter-spacing.tight}"
        },
        "$description": "Subsection heading, 18/24."
      },
      "heading-sm": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{theme.font.sans}",
          "fontWeight": "{ref.typography.weights.semibold}",
          "fontSize": "{ref.typography.sizes.md}",
          "lineHeight": "24px",
          "letterSpacing": "{ref.typography.letter-spacing.default}"
        },
        "$description": "Card and group heading, 16/24."
      },
      "body-md": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{theme.font.sans}",
          "fontWeight": "{ref.typography.weights.regular}",
          "fontSize": "{ref.typography.sizes.md}",
          "lineHeight": "24px",
          "letterSpacing": "{ref.typography.letter-spacing.default}"
        },
        "$description": "Prose, 16/24."
      },
      "body-sm": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{theme.font.sans}",
          "fontWeight": "{ref.typography.weights.regular}",
          "fontSize": "{ref.typography.sizes.sm}",
          "lineHeight": "20px",
          "letterSpacing": "{ref.typography.letter-spacing.default}"
        },
        "$description": "The UI default, 14/20: table cells, descriptions, list rows."
      },
      "label": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{theme.font.sans}",
          "fontWeight": "{ref.typography.weights.medium}",
          "fontSize": "{ref.typography.sizes.sm}",
          "lineHeight": "20px",
          "letterSpacing": "{ref.typography.letter-spacing.default}",
          "textCase": "none"
        },
        "$description": "Control text and form labels, 14/20 at 500."
      },
      "label-md": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{theme.font.sans}",
          "fontWeight": "{ref.typography.weights.medium}",
          "fontSize": "{ref.typography.sizes.sm}",
          "lineHeight": "20px",
          "letterSpacing": "{ref.typography.letter-spacing.default}",
          "textCase": "none"
        },
        "$description": "The label role under its 0.3 name; the same as label."
      },
      "caption": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{theme.font.sans}",
          "fontWeight": "{ref.typography.weights.medium}",
          "fontSize": "{ref.typography.sizes.xs}",
          "lineHeight": "16px",
          "letterSpacing": "{ref.typography.letter-spacing.default}",
          "textCase": "none"
        },
        "$description": "Captions, badges and metadata, 12/16 at 500, not uppercase."
      },
      "mono": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{theme.font.mono}",
          "fontWeight": "{ref.typography.weights.regular}",
          "fontSize": "{ref.typography.sizes.code}",
          "lineHeight": "20px",
          "letterSpacing": "{ref.typography.letter-spacing.default}"
        },
        "$description": "Code, identifiers and figures, 13/20."
      }
    }
  }
}

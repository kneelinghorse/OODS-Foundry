{
  "shadow": {
    "elevation": {
      "card": {
        "$type": "shadow",
        "$value": {
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "8px",
          "spread": "-4px",
          "color": "rgba(0, 0, 0, 0.06)"
        },
        "$description": "A raised card (Card elevated): a soft drop. Cards are border-only by default."
      },
      "overlay": {
        "$type": "shadow",
        "$value": {
          "offsetX": "0px",
          "offsetY": "8px",
          "blur": "16px",
          "spread": "-4px",
          "color": "rgba(0, 0, 0, 0.1)"
        },
        "$description": "Dialogs, popovers and menus: a soft drop under their 1px border."
      }
    }
  }
}

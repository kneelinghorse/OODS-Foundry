{
  "theme-dark": {
    "shadow": {
      "elevation": {
        "card": {
          "$type": "shadow",
          "$value": {
            "offsetX": "0px",
            "offsetY": "0px",
            "blur": "0px",
            "spread": "1px",
            "color": "rgba(255, 255, 255, 0.06)"
          },
          "$description": "Dark: a raised card is a faint ring, not a drop."
        },
        "overlay": {
          "$type": "shadow",
          "$value": {
            "offsetX": "0px",
            "offsetY": "0px",
            "blur": "0px",
            "spread": "1px",
            "color": "rgba(255, 255, 255, 0.1)"
          },
          "$description": "Dark: overlays are a ring, not a drop."
        }
      }
    }
  }
}

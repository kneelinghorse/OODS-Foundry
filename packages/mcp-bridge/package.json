{
  "name": "@oods/mcp-bridge",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "HTTP bridge exposing read-only MCP tools to Storybook",
  "type": "module",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.json && node scripts/build-preview-runtime.mjs && tsc -p preview-app/tsconfig.json && node scripts/build-preview-app.mjs && node ../../scripts/build-revision.mjs dist/build-revision.json",
    "build:preview-app": "tsc -p preview-app/tsconfig.json && node scripts/build-preview-app.mjs",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "vitest run",
    "build:preview-runtime": "node scripts/build-preview-runtime.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@esbuild/darwin-arm64": "0.25.10",
    "@esbuild/darwin-x64": "0.25.10",
    "@esbuild/linux-arm64": "0.25.10",
    "@esbuild/linux-x64": "0.25.10",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "10.1.3",
    "@oods/component-contracts": "0.11.0",
    "@oods/component-styles": "0.11.0",
    "@oods/components-react": "0.11.0",
    "@oods/components-vue": "0.11.0",
    "@oods/tokens": "0.11.0",
    "@vue/compiler-sfc": "^3.5.42",
    "axe-core": "^4.11.0",
    "dotenv": "^17.4.2",
    "esbuild": "0.25.10",
    "fastify": "^5.12.5",
    "playwright-core": "1.56.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@types/node": "^20.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.3.3"
  }
}

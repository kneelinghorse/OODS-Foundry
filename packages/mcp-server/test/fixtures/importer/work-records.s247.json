{
 "about": "s247-m03 fixtures: records of work, and records that are not, as sources the importer drafts. 'before' holds each draft's proposals as the 0.13.1 importer drafted them (id, trait, grade, validity and evidence pointers), captured on 2026-11-13 from a build of the importer before the record-of-work rule.",
 "sources": {
  "sql-work": {
   "format": "sql",
   "name": "work.sql",
   "content": "create table users (id text primary key, name text not null);\ncreate table tickets (id text primary key, title text not null);\ncreate table jobs (\n  id text primary key,\n  title text not null,\n  assignee_id text references users(id),\n  created_by text references users(id),\n  owner_id text references users(id),\n  parent_id text references jobs(id),\n  ticket_id text references tickets(id),\n  status text not null check (status in ('queued', 'in_progress', 'needs_input', 'completed', 'failed')),\n  due_at timestamptz,\n  result text,\n  attempts integer\n);\n"
  },
  "sql-not-work": {
   "format": "sql",
   "name": "work.sql",
   "content": "create table users (id text primary key, name text not null);\ncreate table tickets (id text primary key, title text not null);\ncreate table jobs (\n  id text primary key,\n  title text not null,\n  assignee_id text references users(id),\n  created_by text references users(id),\n  owner_id text references users(id),\n  parent_id text references jobs(id),\n  ticket_id text references tickets(id),\n  status text not null check (status in ('queued', 'in_progress', 'blocked', 'completed', 'failed')),\n  due_at timestamptz,\n  result text,\n  attempts integer\n);\n"
  },
  "prisma-work": {
   "format": "prisma",
   "name": "work.prisma",
   "content": "model User {\n  id   String @id @default(cuid())\n  name String\n}\n\nmodel Job {\n  id         String    @id @default(cuid())\n  title      String\n  status     JobStatus\n  assigneeId String?\n  assignee   User?     @relation(\"assigned\", fields: [assigneeId], references: [id])\n  parentId   String?\n  parent     Job?      @relation(\"tree\", fields: [parentId], references: [id])\n  children   Job[]     @relation(\"tree\")\n}\n\nenum JobStatus {\n  queued\n  in_progress\n  needs_input\n  completed\n}\n"
  },

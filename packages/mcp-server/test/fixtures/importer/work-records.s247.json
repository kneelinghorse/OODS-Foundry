   "name": "work.openapi.json",
   "content": "{\n \"openapi\": \"3.0.1\",\n \"info\": {\n  \"title\": \"Work\",\n  \"version\": \"1\"\n },\n \"paths\": {},\n \"components\": {\n  \"schemas\": {\n   \"User\": {\n    \"type\": \"object\",\n    \"properties\": {\n     \"id\": {\n      \"type\": \"string\"\n     },\n     \"name\": {\n      \"type\": \"string\"\n     }\n    }\n   },\n   \"Agent\": {\n    \"type\": \"object\",\n    \"properties\": {\n     \"id\": {\n      \"type\": \"string\"\n     },\n     \"name\": {\n      \"type\": \"string\"\n     }\n    }\n   },\n   \"Order\": {\n    \"type\": \"object\",\n    \"properties\": {\n     \"id\": {\n      \"type\": \"string\"\n     },\n     \"number\": {\n      \"type\": \"string\"\n     }\n    }\n   },\n   \"AgentJob\": {\n    \"type\": \"object\",\n    \"required\": [\n     \"id\",\n     \"state\"\n    ],\n    \"properties\": {\n     \"id\": {\n      \"type\": \"string\"\n     },\n     \"agent\": {\n      \"$ref\": \"#/components/schemas/Agent\"\n     },\n     \"requested_by\": {\n      \"$ref\": \"#/components/schemas/User\"\n     },\n     \"order\": {\n      \"$ref\": \"#/components/schemas/Order\"\n     },\n     \"parent\": {\n      \"$ref\": \"#/components/schemas/AgentJob\"\n     },\n     \"kind\": {\n      \"type\": \"string\",\n      \"enum\": [\n       \"lookup\",\n       \"refund\",\n       \"reply\"\n      ]\n     },\n     \"state\": {\n      \"type\": \"string\",\n      \"enum\": [\n       \"pending\",\n       \"running\",\n       \"awaiting_input\",\n       \"done\",\n       \"failed\"\n      ]\n     },\n     \"prompt\": {\n      \"type\": \"string\"\n     },\n     \"outcome\": {\n      \"type\": \"string\"\n     },\n     \"run_count\": {\n      \"type\": \"integer\"\n     },\n     \"deadline\": {\n      \"type\": \"string\",\n      \"format\": \"date-time\"\n     },\n     \"created_at\": {\n      \"type\": \"string\",\n      \"format\": \"date-time\",\n      \"readOnly\": true\n     }\n    }\n   },\n   \"Chore\": {\n    \"type\": \"object\",\n    \"properties\": {\n     \"id\": {\n      \"type\": \"string\"\n     },\n     \"title\": {\n      \"type\": \"string\"\n     },\n     \"assignee\": {\n      \"$ref\": \"#/components/schemas/User\"\n     },\n     \"status\": {\n      \"type\": \"string\",\n      \"enum\": [\n       \"todo\",\n       \"working\",\n       \"waiting_for_user\",\n       \"done\"\n      ]\n     },\n     \"result\": {\n      \"type\": \"boolean\"\n     },\n     \"tries\": {\n      \"type\": \"string\"\n     },\n     \"instruction\": {\n      \"type\": \"integer\"\n     },\n     \"due_at\": {\n      \"type\": \"string\"\n     },\n     \"subject_id\": {\n      \"type\": \"integer\"\n     }\n    }\n   },\n   \"Note\": {\n    \"type\": \"object\",\n    \"properties\": {\n     \"id\": {\n      \"type\": \"string\"\n     },\n     \"assignee\": {\n      \"$ref\": \"#/components/schemas/User\"\n     },\n     \"body\": {\n      \"type\": \"string\"\n     }\n    }\n   },\n   \"Job\": {\n    \"type\": \"object\",\n    \"properties\": {\n     \"id\": {\n      \"type\": \"string\"\n     },\n     \"status\": {\n      \"type\": \"string\",\n      \"enum\": [\n       \"queued\",\n       \"in_progress\",\n       \"input_required\",\n       \"completed\"\n      ]\n     }\n    }\n   },\n   \"Errand\": {\n    \"type\": \"object\",\n    \"properties\": {\n     \"id\": {\n      \"type\": \"string\"\n     },\n     \"assignee\": {\n      \"type\": \"string\"\n     },\n     \"state\": {\n      \"type\": \"string\"\n     },\n     \"status\": {\n      \"type\": \"string\",\n      \"enum\": [\n       \"working\",\n       \"needs_input\",\n       \"done\"\n      ]\n     }\n    }\n   },\n   \"Shipment\": {\n    \"type\": \"object\",\n    \"properties\": {\n     \"id\": {\n      \"type\": \"string\"\n     },\n     \"assignee\": {\n      \"$ref\": \"#/components/schemas/User\"\n     },\n     \"status\": {\n      \"type\": \"string\",\n      \"enum\": [\n       \"pending\",\n       \"processing\",\n       \"shipped\",\n       \"delivered\"\n      ]\n     }\n    }\n   },\n   \"Story\": {\n    \"type\": \"object\",\n    \"properties\": {\n     \"id\": {\n      \"type\": \"string\"\n     },\n     \"title\": {\n      \"type\": \"string\"\n     },\n     \"assignee\": {\n      \"$ref\": \"#/components/schemas/User\"\n     },\n     \"parent\": {\n      \"$ref\": \"#/components/schemas/Story\"\n     },\n     \"status\": {\n      \"type\": \"string\",\n      \"enum\": [\n       \"todo\",\n       \"in_progress\",\n       \"blocked\",\n       \"done\"\n      ]\n     }\n    }\n   }\n  }\n }\n}"

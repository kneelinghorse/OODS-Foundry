   "content": "{\n \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n \"$defs\": {\n  \"TaskStatus\": {\n   \"type\": \"object\",\n   \"properties\": {\n    \"state\": {\n     \"anyOf\": [\n      {\n       \"type\": \"string\",\n       \"pattern\": \"^TASK_STATE_UNSPECIFIED$\"\n      },\n      {\n       \"type\": \"string\",\n       \"enum\": [\n        \"TASK_STATE_SUBMITTED\",\n        \"TASK_STATE_WORKING\",\n        \"TASK_STATE_COMPLETED\",\n        \"TASK_STATE_FAILED\",\n        \"TASK_STATE_CANCELED\",\n        \"TASK_STATE_INPUT_REQUIRED\",\n        \"TASK_STATE_REJECTED\",\n        \"TASK_STATE_AUTH_REQUIRED\"\n       ]\n      },\n      {\n       \"type\": \"integer\",\n       \"minimum\": -2147483648,\n       \"maximum\": 2147483647\n      }\n     ],\n     \"default\": 0\n    }\n   }\n  },\n  \"Task\": {\n   \"type\": \"object\",\n   \"properties\": {\n    \"id\": {\n     \"type\": \"string\"\n    },\n    \"contextId\": {\n     \"type\": \"string\"\n    },\n    \"status\": {\n     \"$ref\": \"#/$defs/TaskStatus\"\n    }\n   }\n  },\n  \"Message\": {\n   \"type\": \"object\",\n   \"properties\": {\n    \"messageId\": {\n     \"type\": \"string\"\n    },\n    \"role\": {\n     \"anyOf\": [\n      {\n       \"type\": \"string\",\n       \"pattern\": \"^ROLE_UNSPECIFIED$\"\n      },\n      {\n       \"type\": \"string\",\n       \"enum\": [\n        \"ROLE_USER\",\n        \"ROLE_AGENT\"\n       ]\n      },\n      {\n       \"type\": \"integer\"\n      }\n     ]\n    }\n   }\n  }\n }\n}"

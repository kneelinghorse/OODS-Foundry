  "prisma-grant": {
   "format": "prisma",
   "name": "grants.prisma",
   "content": "model User {\n  id   String @id @default(cuid())\n  name String\n}\n\nmodel Agent {\n  id   String @id @default(cuid())\n  name String\n}\n\nmodel AgentGrant {\n  id          String      @id @default(cuid())\n  name        String\n  status      GrantStatus\n  agentId     String\n  agent       Agent       @relation(fields: [agentId], references: [id])\n  userId      String\n  user        User        @relation(\"for\", fields: [userId], references: [id])\n  grantedById String?\n  grantedBy   User?       @relation(\"granted\", fields: [grantedById], references: [id])\n  expiresAt   DateTime?\n  createdAt   DateTime    @default(now())\n}\n\nenum GrantStatus {\n  active\n  paused\n  revoked\n  expired\n}\n"
  },

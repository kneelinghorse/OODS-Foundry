{
 "about": "s248-m03 fixtures: records of a grant, and records that are not, as sources the importer drafts; the measured schemas in miniature (FDX 6.6's Consent Grant, Stripe's shared payment issued token, ReBIT AA 2.1.0's consent artefact and signed detail, GitHub's organization programmatic access grant). 'before' holds each draft's proposals as the 0.14.0 importer drafted them (id, trait, grade, validity and evidence pointers), captured on 2026-11-14 from the importer's source at the m02 head, before the grant rule and the two general fixes.",
 "sources": {
  "sql-grant": {
   "format": "sql",
   "name": "grants.sql",
   "content": "create table users (id text primary key, name text not null);\ncreate table organizations (id text primary key, name text not null);\ncreate table agents (id text primary key, name text not null);\ncreate table agent_grants (\n  id text primary key,\n  name text not null,\n  agent_id text not null references agents(id),\n  organization_id text not null references organizations(id),\n  granted_by text references users(id),\n  requested_by text references users(id),\n  revoked_by text references users(id),\n  owner_id text references users(id),\n  status text not null check (status in ('requested', 'active', 'paused', 'revoked', 'expired', 'replaced', 'declined', 'withdrawn')),\n  scope text,\n  expires_at timestamptz,\n  timezone text,\n  revoked_reason text,\n  last_used_at timestamptz,\n  uses integer,\n  created_at timestamptz not null,\n  updated_at timestamptz not null\n);\n"
  },

exports[`viz.render render fidelity (renderable, not just AJV-valid) > 'area': viz.render produces a spec that compiles, parses, draws, and keeps its data 1`] = `
{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "autosize": {
    "contains": "padding",
    "type": "fit-y",
  },
  "config": {
    "axis": {
      "domainColor": "#D4D4D4",
      "gridColor": "#E5E5E5",
      "labelColor": "#525252",
      "labelFont": "Geist, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
      "tickColor": "#D4D4D4",
      "titleColor": "#0A0A0A",
      "titleFont": "Geist, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
    },
    "axisX": {
      "grid": false,
    },
    "axisY": {
      "grid": true,
      "tickCount": {
        "expr": "min(5, ceil(height / 40))",
      },
    },
    "background": "#FFFFFF",
    "font": "Geist, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
    "legend": {
      "labelColor": "#525252",
      "labelFont": "Geist, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
      "titleColor": "#0A0A0A",
      "titleFont": "Geist, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
    },
    "title": {
      "anchor": "start",
      "color": "#0A0A0A",
      "font": "Geist, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
      "fontSize": 24,
      "fontWeight": 600,
    },
    "view": {
      "stroke": null,
    },
  },
  "data": {
    "values": [
      {
        "quarter": "2024-01",
        "region": "North",
        "revenue": 120000,
        "units": 340,
      },
      {
        "quarter": "2024-01",
        "region": "South",
        "revenue": 135000,
        "units": 410,
      },
      {
        "quarter": "2024-02",
        "region": "North",
        "revenue": 128000,
        "units": 360,
      },
      {
        "quarter": "2024-02",
        "region": "South",
        "revenue": 142000,
        "units": 430,
      },
      {
        "quarter": "2024-03",
        "region": "North",
        "revenue": 131000,
        "units": 372,
      },
      {
        "quarter": "2024-03",
        "region": "South",
        "revenue": 150000,
        "units": 455,
      },
    ],
  },
  "description": "Area chart of sum of revenue by quarter.",
  "encoding": {
    "x": {
      "axis": {
        "labelExpr": "utcFormat(datum.value, {date: '%b %d'})",
      },
      "field": "quarter",
      "scale": {
        "type": "utc",
      },
      "title": "Quarter",
      "type": "temporal",
    },
    "y": {
      "aggregate": "sum",
      "field": "revenue",
      "title": "Revenue",
      "type": "quantitative",
    },
  },
  "height": 300,
  "mark": {
    "color": "#3E63DD",
    "type": "area",
  },
  "title": "Area chart",
  "usermeta": {
    "oods": {
      "a11y": {
        "ariaLabel": "Area chart of Revenue by Quarter",
        "description": "Area chart of sum of revenue by quarter.",
      },
      "name": "Area chart",
      "portability": {
        "tableColumnOrder": [
          "quarter",
          "revenue",
          "region",
          "units",
        ],
      },
      "specId": "viz:area",
    },
  },
}
`;


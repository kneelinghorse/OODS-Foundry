{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://designlab.local/schemas/map.update.input.json",
  "title": "map.update input",
  "description": "Partially update an existing component-to-trait mapping.",
  "type": "object",
  "required": ["id", "updates"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Mapping ID to update (e.g., 'team-button')."
    },
    "updates": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "description": "Fields to update. Only provided fields are changed.",
      "properties": {
        "substitution": {
          "type": "object",
          "required": [
            "component"
          ],
          "additionalProperties": false,
          "anyOf": [
            {
              "required": [
                "react"
              ]
            },
            {
              "required": [
                "vue"
              ]
            }
          ],
          "properties": {
            "component": {
              "type": "string",
              "minLength": 1,
              "description": "The shipped OODS Foundry component id being replaced."
            },
            "react": {
              "type": "object",
              "required": [
                "export"
              ],
              "additionalProperties": false,
              "properties": {
                "localPath": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Absolute built package directory used by preview; omitted from consumer source imports."
                },
                "package": {
                  "type": "string",
                  "minLength": 1
                },
                "export": {
                  "type": "string",
                  "pattern": "^[A-Za-z_$][\\w$]*$"
                },
                "version": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
                  "description": "Exact team package version; code generation needs this or an installed package manifest."
                },
                "passthrough": {
                  "type": "boolean",
                  "default": true,
                  "description": "Unlisted OODS Foundry props keep their names. False drops unlisted optional props; required props must be translated."
                },
                "props": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "required": [
                      "name"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string",
                        "pattern": "^[A-Za-z_$][\\w$]*$"
                      },
                      "values": {
                        "type": "object",
                        "additionalProperties": {
                          "type": [
                            "string",
                            "number",
                            "boolean",
                            "null"
                          ]
                        }
                      }
                    }
                  },
                  "description": "OODS Foundry prop to team prop, with optional scalar value map; values not in the map are preserved. Children, slots and event bindings keep their framework conventions."
                },
                "shadcn": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "project",
                    "module"
                  ],
                  "properties": {
                    "project": {
                      "type": "string",
                      "pattern": "^/[\\s\\S]*$",
                      "description": "Absolute shadcn project directory containing components.json and installed Tailwind 4 with Vite or PostCSS. React supports Radix and Base UI; Vue supports shadcn-vue on Reka. React Aria and unknown styles are refused."
                    },
                    "module": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Project import beginning with a components.json alias and resolved by TypeScript paths."
                    }
                  }
                }
              },
              "oneOf": [
                {
                  "required": [
                    "package"
                  ],
                  "not": {
                    "required": [
                      "shadcn"
                    ]
                  }
                },
                {
                  "required": [
                    "shadcn"
                  ],
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "package"
                        ]
                      },
                      {
                        "required": [
                          "version"
                        ]
                      },
                      {
                        "required": [
                          "localPath"
                        ]
                      }
                    ]
                  }
                }
              ]
            },
            "vue": {
              "type": "object",
              "required": [
                "export"
              ],
              "additionalProperties": false,
              "properties": {
                "localPath": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Absolute built package directory used by preview; omitted from consumer source imports."
                },
                "package": {
                  "type": "string",
                  "minLength": 1
                },
                "export": {
                  "type": "string",
                  "pattern": "^[A-Za-z_$][\\w$]*$"
                },
                "version": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
                  "description": "Exact team package version; code generation needs this or an installed package manifest."
                },
                "passthrough": {
                  "type": "boolean",
                  "default": true,
                  "description": "Unlisted OODS Foundry props keep their names. False drops unlisted optional props; required props must be translated."
                },
                "props": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "required": [
                      "name"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string",
                        "pattern": "^[A-Za-z_$][\\w$]*$"
                      },
                      "values": {
                        "type": "object",
                        "additionalProperties": {
                          "type": [
                            "string",
                            "number",
                            "boolean",
                            "null"
                          ]
                        }
                      }
                    }
                  },
                  "description": "OODS Foundry prop to team prop, with optional scalar value map; values not in the map are preserved. Children, slots and event bindings keep their framework conventions."
                },
                "shadcn": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "project",
                    "module"
                  ],
                  "properties": {
                    "project": {
                      "type": "string",
                      "pattern": "^/[\\s\\S]*$",
                      "description": "Absolute shadcn project directory containing components.json and installed Tailwind 4 with Vite or PostCSS. React supports Radix and Base UI; Vue supports shadcn-vue on Reka. React Aria and unknown styles are refused."
                    },
                    "module": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Project import beginning with a components.json alias and resolved by TypeScript paths."
                    }
                  }
                }
              },
              "oneOf": [
                {
                  "required": [
                    "package"
                  ],
                  "not": {
                    "required": [
                      "shadcn"
                    ]
                  }
                },
                {
                  "required": [
                    "shadcn"
                  ],
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "package"
                        ]
                      },
                      {
                        "required": [
                          "version"
                        ]
                      },
                      {
                        "required": [
                          "localPath"
                        ]
                      }
                    ]
                  }
                }
              ]
            }
          },
          "description": "Version 2 component substitution: an OODS Foundry id, React and/or Vue package exports, and OODS Foundry-to-team prop translations. Legacy trait-only mappings remain valid."
        },
        "oodsTraits": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "description": "Replace OODS trait list."
        },
        "confidence": {
          "type": "string",
          "enum": ["auto", "manual"],
          "description": "Update confidence level."
        },
        "propMappings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["externalProp", "oodsProp"],
            "additionalProperties": false,
            "properties": {
              "externalProp": { "type": "string", "minLength": 1 },
              "oodsProp": { "type": "string", "minLength": 1 },
              "coercion": {
                "description": "Legacy external-to-OODS Foundry annotation: a structured hint, raw captured label, or null. Stored and resolved as data; use substitution.props for executable OODS Foundry-to-team translation.",
                "oneOf": [
                  { "type": "null" },
                  { "type": "string", "minLength": 1 },
                  {
                    "type": "object",
                    "required": ["type", "mapping"],
                    "additionalProperties": false,
                    "properties": {
                      "type": { "const": "enum" },
                      "mapping": { "type": "object", "additionalProperties": { "type": "string" } }
                    }
                  },
                  {
                    "type": "object",
                    "required": ["type", "trueValue", "falseValue"],
                    "additionalProperties": false,
                    "properties": {
                      "type": { "const": "boolean_to_string" },
                      "trueValue": { "type": "string" },
                      "falseValue": { "type": "string" }
                    }
                  },
                  {
                    "type": "object",
                    "required": ["type", "pattern"],
                    "additionalProperties": false,
                    "properties": {
                      "type": { "const": "template" },
                      "pattern": { "type": "string" }
                    }
                  },
                  {
                    "type": "object",
                    "required": ["type"],
                    "additionalProperties": false,
                    "properties": {
                      "type": { "const": "identity" }
                    }
                  }
                ],
                "default": null
              }
            }
          },
          "description": "Replace property mappings."
        },
        "notes": {
          "type": "string",
          "description": "Update notes in metadata."
        },
        "projection_variants": {
          "type": "array",
          "description": "Replace Stage1 v1.5.0 cross-surface projection variants. Pass an empty array to clear; omit to leave unchanged.",
          "items": {
            "type": "object",
            "required": ["id", "surface"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "surface": { "type": "string", "minLength": 1 },
              "external_component": { "type": "string", "minLength": 1 },
              "capability_id": { "type": "string", "minLength": 1 },
              "selector": { "type": "string", "minLength": 1 },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "evidence_chain": {
                "type": "array",
                "items": { "type": "object", "additionalProperties": true }
              },
              "metadata": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        }
      }
    }
  }
}

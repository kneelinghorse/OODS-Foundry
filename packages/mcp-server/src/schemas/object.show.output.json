{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "maturity": {
      "type": [
        "string",
        "null"
      ]
    },
    "traits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "alias": {
            "type": [
              "string",
              "null"
            ]
          },
          "parameters": {
            "type": [
              "object",
              "null"
            ]
          },
          "fieldBindings": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "required": [
          "name",
          "alias",
          "parameters"
        ],
        "additionalProperties": false
      }
    },
    "schema": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          },
          "default": {},
          "defaultFromParameter": {
            "type": "string"
          },
          "validation": {
            "type": "object"
          }
        },
        "required": [
          "type",
          "required",
          "description"
        ],
        "additionalProperties": true
      }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "semantic_type": {
            "type": "string"
          },
          "token_mapping": {
            "type": "string"
          },
          "ui_hints": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "boolean",
                "number"
              ]
            }
          }
        },
        "required": [
          "semantic_type",
          "token_mapping"
        ],
        "additionalProperties": false
      }
    },
    "viewExtensions": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "component": {
              "type": "string"
            },
            "position": {
              "type": "string"
            },
            "priority": {
              "type": "number"
            },
            "props": {
              "type": "object"
            }
          },
          "required": [
            "component"
          ],
          "additionalProperties": false
        }
      }
    },
    "tokens": {
      "type": "object"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "filePath": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "shipped",
        "user"
      ],
      "description": "shipped: OODS Foundry's own. user: from your folder."
    },
    "replaces": {
      "type": "string",
      "description": "The shipped file your object is used in place of."
    },
    "relationships": {
      "type": "array",
      "description": "Authored type associations, never inferred from UUID names.",
      "items": {
        "type": "object",
        "required": [
          "target",
          "via",
          "cardinality",
          "label"
        ],
        "properties": {
          "target": {
            "type": "string"
          },
          "via": {
            "type": "string"
          },
          "cardinality": {
            "type": "string",
            "enum": [
              "one-to-one",
              "one-to-many",
              "many-to-one",
              "many-to-many"
            ]
          },
          "label": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": [
    "name",
    "version",
    "domain",
    "description",
    "tags",
    "maturity",
    "traits",
    "schema",
    "semantics",
    "viewExtensions",
    "tokens",
    "warnings",
    "filePath",
    "source"
  ],
  "additionalProperties": false
}

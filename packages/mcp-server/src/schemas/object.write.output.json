              "status",
              "messages"
            ],
            "additionalProperties": false
          },
          "description": "An object composed through design_compose in every context it declares (empty for a trait)."
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "registry": {

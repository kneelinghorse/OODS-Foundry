                },
                "user": {
                  "type": "integer"
                },
                "replacingShipped": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Your objects used in place of a shipped object of the same name."
                }
              },
              "required": [
                "total",
                "shipped",
                "user",
                "replacingShipped"
              ],
              "additionalProperties": false

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "folders": {
      "type": "object",
      "description": "Your objects and traits folders (OODS_OBJECTS_DIR, OODS_TRAITS_DIR); null when none is set.",
      "properties": {
        "objects": {
          "type": [
            "string",
            "null"
          ]
        },
        "traits": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "objects",
        "traits"
      ],
      "additionalProperties": false
    },
    "objects": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer"
        },
        "shipped": {
          "type": "integer"
        },
        "user": {
          "type": "integer"
        },
        "replacingShipped": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Your objects used in place of a shipped object of the same name."
        }
      },
      "required": [
        "total",
        "shipped",
        "user",
        "replacingShipped"
      ],
      "additionalProperties": false
    },
    "traits": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer"
        },
        "shipped": {
          "type": "integer"
        },
        "user": {
          "type": "integer"
        }
      },
      "required": [
        "total",
        "shipped",
        "user"
      ],
      "additionalProperties": false
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "A file that was not used, or something about one that is, and why.",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "malformed",
              "unnamed",
              "duplicate",
              "replaces-shipped",
              "shipped-name",
              "unknown-trait",
              "unreadable-folder"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "notice"
            ],
            "description": "error: the definition is not in use. notice: it is in use, and this is worth knowing."
          },
          "file": {
            "type": "string",
            "description": "A shipped file relative to the runtime root; a file of yours as an absolute path."
          },
          "name": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "severity",
          "file",
          "message"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "folders",
    "objects",
    "traits",
    "issues"
  ],
  "additionalProperties": false
}

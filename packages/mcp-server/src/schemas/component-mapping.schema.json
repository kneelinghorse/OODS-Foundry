{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oods-foundry.com/schemas/component-mapping.schema.json",
  "title": "Component Mapping Schema",
  "description": "Version 2 mapping records: legacy external-to-trait annotations and optional validated OODS Foundry-to-team component substitutions, stored outside the runtime.",
  "type": "object",
  "required": ["generatedAt", "version", "stats", "mappings"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp of last modification."
    },
    "version": {
      "type": "string",
      "description": "Date-stamped version (e.g., '2026-02-28')."
    },
    "stats": {
      "type": "object",
      "required": ["mappingCount", "systemCount"],
      "additionalProperties": false,
      "properties": {
        "mappingCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of component mappings."
        },
        "systemCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of distinct external systems."
        }
      }
    },
    "mappings": {
      "type": "array",
      "items": { "$ref": "#/$defs/ComponentMapping" },
      "description": "Array of component mapping records."
    },
    "disambiguation_decisions": {
      "type": "array",
      "description": "Draft v1.4.0-gated review-decision events promoted into the registry. Top-level (cross-mapping). Additive stub only; absent on pre-v1.4.0 docs.",
      "items": { "$ref": "#/$defs/Stage1DisambiguationDecision" }
    },
    "preferred_terms": {
      "type": "array",
      "description": "Draft v1.4.0-gated canonical-term entities promoted into the registry. Top-level (cross-mapping). Additive stub only; absent on pre-v1.4.0 docs.",
      "items": { "$ref": "#/$defs/Stage1PreferredTermEntity" }
    },
    "capabilities": {
      "type": "array",
      "description": "Draft v1.4.0-gated first-class capability entities rolled up across mappings. Top-level (cross-mapping). Additive stub only; absent on pre-v1.4.0 docs.",
      "items": { "$ref": "#/$defs/Stage1CapabilityEntity" }
    }
  },
  "$defs": {
    "ComponentMapping": {
      "type": "object",
      "required": [
        "id",
        "externalSystem",
        "externalComponent",
        "oodsTraits",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "substitution": {
          "type": "object",
          "required": [
            "component"
          ],
          "additionalProperties": false,
          "anyOf": [
            {
              "required": [
                "react"
              ]
            },
            {
              "required": [
                "vue"
              ]
            }
          ],
          "properties": {
            "component": {
              "type": "string",
              "minLength": 1,
              "description": "The shipped OODS Foundry component id being replaced."
            },
            "react": {
              "type": "object",
              "required": [
                "export"
              ],
              "additionalProperties": false,
              "properties": {
                "localPath": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Absolute built package directory used by preview; omitted from consumer source imports."
                },
                "package": {
                  "type": "string",
                  "minLength": 1
                },
                "export": {
                  "type": "string",
                  "pattern": "^[A-Za-z_$][\\w$]*$"
                },
                "version": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
                  "description": "Exact team package version; code generation needs this or an installed package manifest."
                },
                "passthrough": {
                  "type": "boolean",
                  "default": true,
                  "description": "Unlisted OODS Foundry props keep their names. False drops unlisted optional props; required props must be translated."
                },
                "props": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "required": [
                      "name"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string",
                        "pattern": "^[A-Za-z_$][\\w$]*$"
                      },
                      "values": {
                        "type": "object",
                        "additionalProperties": {
                          "type": [
                            "string",
                            "number",
                            "boolean",
                            "null"
                          ]
                        }
                      }
                    }
                  },
                  "description": "OODS Foundry prop to team prop, with optional scalar value map; values not in the map are preserved. Children, slots and event bindings keep their framework conventions."
                },
                "shadcn": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "project",
                    "module"
                  ],
                  "properties": {
                    "project": {
                      "type": "string",
                      "pattern": "^/[\\s\\S]*$",
                      "description": "Absolute React/Vue shadcn project directory containing components.json and installed Tailwind 4."
                    },
                    "module": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Project import beginning with a components.json alias and resolved by TypeScript paths."
                    }
                  }
                }
              },
              "oneOf": [
                {
                  "required": [
                    "package"
                  ],
                  "not": {
                    "required": [
                      "shadcn"
                    ]
                  }
                },
                {
                  "required": [
                    "shadcn"
                  ],
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "package"
                        ]
                      },
                      {
                        "required": [
                          "version"
                        ]
                      },
                      {
                        "required": [
                          "localPath"
                        ]
                      }
                    ]
                  }
                }
              ]
            },
            "vue": {
              "type": "object",
              "required": [
                "export"
              ],
              "additionalProperties": false,
              "properties": {
                "localPath": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Absolute built package directory used by preview; omitted from consumer source imports."
                },
                "package": {
                  "type": "string",
                  "minLength": 1
                },
                "export": {
                  "type": "string",
                  "pattern": "^[A-Za-z_$][\\w$]*$"
                },
                "version": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
                  "description": "Exact team package version; code generation needs this or an installed package manifest."
                },
                "passthrough": {
                  "type": "boolean",
                  "default": true,
                  "description": "Unlisted OODS Foundry props keep their names. False drops unlisted optional props; required props must be translated."
                },
                "props": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "required": [
                      "name"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string",
                        "pattern": "^[A-Za-z_$][\\w$]*$"
                      },
                      "values": {
                        "type": "object",
                        "additionalProperties": {
                          "type": [
                            "string",
                            "number",
                            "boolean",
                            "null"
                          ]
                        }
                      }
                    }
                  },
                  "description": "OODS Foundry prop to team prop, with optional scalar value map; values not in the map are preserved. Children, slots and event bindings keep their framework conventions."
                },
                "shadcn": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "project",
                    "module"
                  ],
                  "properties": {
                    "project": {
                      "type": "string",
                      "pattern": "^/[\\s\\S]*$",
                      "description": "Absolute React/Vue shadcn project directory containing components.json and installed Tailwind 4."
                    },
                    "module": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Project import beginning with a components.json alias and resolved by TypeScript paths."
                    }
                  }
                }
              },
              "oneOf": [
                {
                  "required": [
                    "package"
                  ],
                  "not": {
                    "required": [
                      "shadcn"
                    ]
                  }
                },
                {
                  "required": [
                    "shadcn"
                  ],
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "package"
                        ]
                      },
                      {
                        "required": [
                          "version"
                        ]
                      },
                      {
                        "required": [
                          "localPath"
                        ]
                      }
                    ]
                  }
                }
              ]
            }
          },
          "description": "Version 2 component substitution: an OODS Foundry id, React and/or Vue package exports, and OODS Foundry-to-team prop translations. Legacy trait-only mappings remain valid."
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "Unique mapping identifier (e.g., 'team-button')."
        },
        "externalSystem": {
          "type": "string",
          "minLength": 1,
          "description": "External design system name (for example, 'team')."
        },
        "externalComponent": {
          "type": "string",
          "minLength": 1,
          "description": "Component name in the external system (e.g., 'Button', 'TextField')."
        },
        "oodsTraits": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 0,
          "description": "OODS trait names this component maps to (e.g., ['Stateful', 'Taggable'])."
        },
        "propMappings": {
          "type": "array",
          "items": { "$ref": "#/$defs/PropMapping" },
          "default": [],
          "description": "Property translations from external to OODS prop names."
        },
        "confidence": {
          "type": "string",
          "enum": ["auto", "manual"],
          "description": "'auto' for machine-generated mappings, 'manual' for human-curated."
        },
        "metadata": { "$ref": "#/$defs/MappingMetadata" },
        "projection_variants": {
          "type": "array",
          "description": "Draft v1.4.0-gated cross-surface identity relation. map create and apply write it when supplied, update sets or removes it, and resolution returns it unchanged; nothing else reads it.",
          "items": { "$ref": "#/$defs/ProjectionVariant" }
        }
      },
      "allOf": [
        {
          "if": {
            "not": {
              "required": [
                "substitution"
              ]
            }
          },
          "then": {
            "properties": {
              "oodsTraits": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "PropMapping": {
      "type": "object",
      "required": ["externalProp", "oodsProp"],
      "additionalProperties": false,
      "properties": {
        "externalProp": {
          "type": "string",
          "minLength": 1,
          "description": "Property name in the external system."
        },
        "oodsProp": {
          "type": "string",
          "minLength": 1,
          "description": "Corresponding OODS property name."
        },
        "coercion": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/CoercionDef" }],
          "default": null,
          "description": "Type coercion hint. null for direct pass-through."
        }
      }
    },
    "CoercionDef": {
      "description": "Typed coercion transform. Discriminated union on the 'type' field.",
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "mapping"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "const": "enum",
              "description": "Enum value mapping: source value lookup to target value."
            },
            "mapping": {
              "type": "object",
              "additionalProperties": { "type": "string" },
              "description": "Source value to target value mapping."
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "trueValue", "falseValue"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "const": "boolean_to_string",
              "description": "Convert boolean to string representation."
            },
            "trueValue": {
              "type": "string",
              "description": "String value when source is true."
            },
            "falseValue": {
              "type": "string",
              "description": "String value when source is false."
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "pattern"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "const": "template",
              "description": "String interpolation using {{value}} placeholder."
            },
            "pattern": {
              "type": "string",
              "description": "Template pattern with {{value}} placeholder."
            }
          }
        },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "const": "identity",
              "description": "Pass-through, no transformation."
            }
          }
        }
      ]
    },
    "MappingMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the mapping was first created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the mapping was last updated."
        },
        "author": {
          "type": "string",
          "description": "Who created or last edited this mapping."
        },
        "notes": {
          "type": "string",
          "description": "Free-form notes about this mapping."
        }
      }
    },
    "ProjectionVariant": {
      "type": "object",
      "required": ["id", "surface"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable identifier for the cross-surface projection."
        },
        "surface": {
          "type": "string",
          "minLength": 1,
          "description": "Surface label such as desktop, mobile, modal, or sidebar."
        },
        "external_component": {
          "type": "string",
          "minLength": 1,
          "description": "Surface-specific component label when it differs from the canonical map name."
        },
        "capability_id": {
          "type": "string",
          "minLength": 1,
          "description": "Optional first-class capability entity linked to this projection."
        },
        "selector": {
          "type": "string",
          "minLength": 1,
          "description": "Representative selector or cluster signature."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Confidence of the cross-surface identity merge."
        },
        "evidence_chain": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true },
          "description": "Evidence supporting the identity-resolution link."
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true,
          "description": "Open metadata bag reserved for future v1.4.0+ relation details."
        }
      }
    },
    "Stage1DisambiguationDecision": {
      "type": "object",
      "required": [
        "decision_id",
        "decision_type",
        "scope",
        "status",
        "target_kind",
        "target_id",
        "selected_value",
        "rationale",
        "decided_at"
      ],
      "additionalProperties": false,
      "properties": {
        "decision_id": { "type": "string", "minLength": 1 },
        "decision_type": {
          "type": "string",
          "enum": ["preferred_name", "preferred_role", "mapping_rejection", "canonical_term"]
        },
        "scope": { "type": "string", "enum": ["run", "target", "registry"] },
        "status": { "type": "string", "enum": ["proposed", "accepted", "rejected", "promoted"] },
        "target_kind": { "type": "string", "enum": ["candidate_object", "candidate_action", "preferred_term"] },
        "target_id": { "type": "string", "minLength": 1 },
        "selected_value": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["value"],
            "additionalProperties": false,
            "properties": {
              "value": { "type": "string", "minLength": 1 },
              "score": { "type": "number", "minimum": 0, "maximum": 1 },
              "reasoning": { "type": "string", "minLength": 1 }
            }
          }
        },
        "preferred_term_id": { "type": "string", "minLength": 1 },
        "decided_by": { "type": "string", "enum": ["human", "agent", "system"] },
        "decided_at": { "type": "string", "format": "date-time" },
        "metadata": { "type": "object", "additionalProperties": true }
      }
    },
    "Stage1PreferredTermEntity": {
      "type": "object",
      "required": ["entity_type", "id", "slug", "label", "aliases", "scope"],
      "additionalProperties": false,
      "properties": {
        "entity_type": { "type": "string", "const": "preferred_term" },
        "id": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "label": { "type": "string", "minLength": 1 },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "scope": { "type": "string", "enum": ["target", "registry"] },
        "domain": { "type": "string", "minLength": 1 },
        "source_decision_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "metadata": { "type": "object", "additionalProperties": true }
      }
    },
    "Stage1CapabilityEntity": {
      "type": "object",
      "required": ["entity_type", "id", "slug", "name", "canonical_verb"],
      "additionalProperties": false,
      "properties": {
        "entity_type": { "type": "string", "const": "capability" },
        "id": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "canonical_verb": { "type": "string", "minLength": 1 },
        "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "oods_traits": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "projection_variant_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type"],
            "additionalProperties": false,
            "properties": {
              "type": { "type": "string", "enum": ["auth", "role", "state", "data"] },
              "description": { "type": "string" },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "evidence_chain": {
                "type": "array",
                "items": { "type": "object", "additionalProperties": true }
              }
            }
          }
        },
        "metadata": { "type": "object", "additionalProperties": true }
      }
    }
  }
}

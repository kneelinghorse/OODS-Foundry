{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://oods-foundry.com/design-loop/receipt.schema.json",
  "title": "Browser design loop render receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "framework",
    "compose",
    "schemaHash",
    "artifactContentHash",
    "files",
    "sourceHead",
    "model",
    "steps",
    "clock",
    "locale",
    "timezone",
    "packages",
    "views",
    "errors",
    "timings",
    "output",
    "consumer"
  ],
  "properties": {
    "version": {
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "framework": {
      "enum": [
        "react",
        "vue"
      ]
    },
    "compose": {
      "type": "object"
    },
    "schemaHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "artifactContentHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "contentHash"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "contentHash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    },
    "sourceHead": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "model": {
      "type": "object"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "action",
          "selector"
        ],
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "click",
              "fill",
              "select",
              "check"
            ]
          },
          "selector": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      }
    },
    "clock": {
      "type": "string"
    },
    "locale": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "version",
          "sha256",
          "installSpec"
        ]
      }
    },
    "views": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "width",
          "accessibility",
          "screenshot",
          "screenshotHash",
          "dump",
          "measurements",
          "values",
          "regions"
        ],
        "properties": {
          "width": {
            "type": "integer"
          },
          "accessibility": {
            "type": "string"
          },
          "visibleText": {
            "type": "string"
          },
          "screenshot": {
            "type": "string"
          },
          "screenshotHash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "dump": {
            "type": "string"
          },
          "measurements": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "viewportWidth",
              "documentWidth",
              "elementCount",
              "overflow",
              "glyphWraps"
            ],
            "properties": {
              "viewportWidth": {
                "type": "integer"
              },
              "documentWidth": {
                "type": "number"
              },
              "elementCount": {
                "type": "integer"
              },
              "overflow": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "element",
                    "left",
                    "right",
                    "width"
                  ],
                  "properties": {
                    "element": {
                      "type": "string"
                    },
                    "left": {
                      "type": "number"
                    },
                    "right": {
                      "type": "number"
                    },
                    "width": {
                      "type": "number"
                    }
                  }
                }
              },
              "glyphWraps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "element",
                    "text",
                    "lines"
                  ],
                  "properties": {
                    "element": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    },
                    "lines": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "bodyBackground": {
                "type": "string"
              },
              "chartCanvasFills": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "values": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "element",
                "name",
                "value",
                "checked"
              ],
              "properties": {
                "element": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                },
                "checked": {
                  "type": "boolean"
                }
              }
            }
          },
          "regions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "component",
                "text"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "component": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "text"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "timings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "composeMs",
        "generateMs",
        "captureMs"
      ],
      "properties": {
        "composeMs": {
          "type": "number"
        },
        "generateMs": {
          "type": "number"
        },
        "captureMs": {
          "type": "number"
        }
      }
    },
    "output": {
      "type": "string"
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "port",
        "pid"
      ],
      "properties": {
        "root": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "pid": {
          "type": "integer"
        }
      }
    },
    "clockStepMs": {
      "const": 1,
      "description": "Deterministic 1 ms advance before each interaction preserves event ordering."
    },
    "theme": {
      "enum": [
        "light",
        "dark"
      ]
    },
    "brand": {
      "description": "A brand in the brand registry (s213-m04); the render checked it against the token build.",
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]{0,31}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "version": {
            "const": "1.1"
          }
        }
      },
      "then": {
        "required": [
          "theme",
          "brand"
        ],
        "properties": {
          "views": {
            "items": {
              "properties": {
                "measurements": {
                  "required": [
                    "bodyBackground",
                    "chartCanvasFills"
                  ],
                  "type": "object"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        }
      }
    }
  ]
}

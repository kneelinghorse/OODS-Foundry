// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Subscription view integration > includes renewal summary and progress indicator > main-renewal-summary 1`] = `"<div data-extension-id="billable:price-summary" data-extension-type="section" data-extension-region="main" data-extension-trait="Billable" style="display:contents"><div class="oods-card flex flex-col gap-3" data-oods-component="Card" data-elevated="false"><div><h2 class="oods-text" data-oods-component="Text" data-size="lg" data-weight="semibold">Billing</h2><p class="oods-text text-slate-500 dark:text-slate-400" data-oods-component="Text" data-size="sm" data-weight="regular">$99.00 / month</p></div><dl class="grid grid-cols-1 gap-3 sm:grid-cols-2"><div class="flex flex-col gap-1"><dt class="oods-text text-slate-500 dark:text-slate-400" data-oods-component="Text" data-size="sm" data-weight="regular">Last payment</dt><dd class="oods-text" data-oods-component="Text" data-size="md" data-weight="medium">May 1, 2024</dd></div><div class="flex flex-col gap-1"><dt class="oods-text text-slate-500 dark:text-slate-400" data-oods-component="Text" data-size="sm" data-weight="regular">Next payment due</dt><dd class="oods-text" data-oods-component="Text" data-size="md" data-weight="medium">May 31, 2024</dd></div></dl></div></div><div data-extension-id="timestampable:renewal-summary" data-extension-type="section" data-extension-region="main" data-extension-trait="Timestampable" style="display:contents"><div class="oods-card flex flex-col gap-4" data-oods-component="Card" data-elevated="false"><div class="flex flex-col gap-1"><h2 class="oods-text" data-oods-component="Text" data-size="lg" data-weight="semibold">Renewal</h2><p class="oods-text text-slate-500 dark:text-slate-400" data-oods-component="Text" data-size="sm" data-weight="regular">Renews on May 31, 2024</p></div><div class="flex flex-col gap-3"><div class="flex items-center justify-between text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400"><span>May 1, 2024</span><span>May 31, 2024</span></div><div class="h-2 overflow-hidden rounded-full bg-slate-200 dark:bg-slate-800"><div class="h-full rounded-full bg-emerald-500 dark:bg-emerald-400" style="width:35%" aria-label="Billing cycle 35% complete"></div></div><p class="oods-text text-right text-slate-500 dark:text-slate-400" data-oods-component="Text" data-size="sm" data-weight="regular">35% of cycle elapsed</p></div></div></div><div data-extension-id="cancellable:scheduled-banner" data-extension-type="section" data-extension-region="main" data-extension-trait="Cancellable" style="display:contents"></div>"`;

exports[`Subscription view integration > renders cancellation banner only when scheduled at period end > main-cancel-at-period-end 1`] = `"<div data-extension-id="billable:price-summary" data-extension-type="section" data-extension-region="main" data-extension-trait="Billable" style="display:contents"><div class="oods-card flex flex-col gap-3" data-oods-component="Card" data-elevated="false"><div><h2 class="oods-text" data-oods-component="Text" data-size="lg" data-weight="semibold">Billing</h2><p class="oods-text text-slate-500 dark:text-slate-400" data-oods-component="Text" data-size="sm" data-weight="regular">$129.00 / month</p></div><dl class="grid grid-cols-1 gap-3 sm:grid-cols-2"><div class="flex flex-col gap-1"><dt class="oods-text text-slate-500 dark:text-slate-400" data-oods-component="Text" data-size="sm" data-weight="regular">Last payment</dt><dd class="oods-text" data-oods-component="Text" data-size="md" data-weight="medium">May 10, 2024</dd></div><div class="flex flex-col gap-1"><dt class="oods-text text-slate-500 dark:text-slate-400" data-oods-component="Text" data-size="sm" data-weight="regular">Next payment due</dt><dd class="oods-text" data-oods-component="Text" data-size="md" data-weight="medium">Jun 9, 2024</dd></div></dl></div></div><div data-extension-id="timestampable:renewal-summary" data-extension-type="section" data-extension-region="main" data-extension-trait="Timestampable" style="display:contents"><div class="oods-card flex flex-col gap-4" data-oods-component="Card" data-elevated="false"><div class="flex flex-col gap-1"><h2 class="oods-text" data-oods-component="Text" data-size="lg" data-weight="semibold">Renewal</h2><p class="oods-text text-slate-500 dark:text-slate-400" data-oods-component="Text" data-size="sm" data-weight="regular">Renews on Jun 9, 2024</p></div><div class="flex flex-col gap-3"><div class="flex items-center justify-between text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400"><span>May 10, 2024</span><span>Jun 9, 2024</span></div><div class="h-2 overflow-hidden rounded-full bg-slate-200 dark:bg-slate-800"><div class="h-full rounded-full bg-emerald-500 dark:bg-emerald-400" style="width:52%" aria-label="Billing cycle 52% complete"></div></div><p class="oods-text text-right text-slate-500 dark:text-slate-400" data-oods-component="Text" data-size="sm" data-weight="regular">52% of cycle elapsed</p></div></div></div><div data-extension-id="cancellable:scheduled-banner" data-extension-type="section" data-extension-region="main" data-extension-trait="Cancellable" style="display:contents"><div class="oods-card border-amber-200/70 bg-amber-50/80 text-amber-900 dark:border-amber-500/40 dark:bg-amber-900/30 dark:text-amber-100" data-oods-component="Card" data-elevated="false"><h2 class="oods-text" data-oods-component="Text" data-size="md" data-weight="semibold">Cancellation scheduled at period end</h2><p class="oods-text text-amber-800/90 dark:text-amber-200" data-oods-component="Text" data-size="sm" data-weight="regular">Reason: Switching to annual billing with reseller</p><p class="oods-text text-amber-700/80 dark:text-amber-300" data-oods-component="Text" data-size="sm" data-weight="regular">Requested May 15, 2024</p></div></div>"`;

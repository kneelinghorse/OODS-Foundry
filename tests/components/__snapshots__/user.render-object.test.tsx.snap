exports[`User view integration > only alters the pageHeader region when Taggable trait is removed > pageHeader-with-tags 1`] = `"<div data-extension-id="stateful:page-header" data-extension-type="section" data-extension-region="pageHeader" data-extension-trait="Stateful" style="display:contents"><header class="flex flex-col gap-4 rounded-xl bg-surface-muted px-6 py-5 shadow-card dark:bg-slate-900/60"><div class="flex flex-wrap items-start justify-between gap-4"><div class="flex min-w-0 flex-col gap-2"><span class="oods-text text-sm font-medium uppercase tracking-wide text-slate-500 dark:text-slate-300" data-oods-component="Text" data-size="sm" data-weight="medium">ada.lovelace@example.com</span><h1 class="oods-text truncate text-foreground" data-oods-component="Text" data-size="lg" data-weight="semibold">Ada</h1><p class="oods-text text-sm text-slate-600 dark:text-slate-400 max-w-2xl" data-oods-component="Text" data-size="md" data-weight="regular">Computing pioneer and analytics architect.</p></div><div class="shrink-0 text-sm text-slate-500"><div class="flex flex-col text-right text-sm text-slate-500 dark:text-slate-400"><span class="oods-text" data-oods-component="Text" data-size="sm" data-weight="regular">Joined Mar 18, 2024</span><span class="oods-text" data-oods-component="Text" data-size="sm" data-weight="regular">Last updated Jun 12, 2024</span><span class="oods-text" data-oods-component="Text" data-size="sm" data-weight="regular">Profile Updated (Jun 12, 2024)</span></div></div></div></header></div><div data-extension-id="Stateful:page-header:status-chip" data-extension-type="section" data-extension-region="pageHeader" data-extension-trait="Stateful" style="display:contents"><div class="flex items-center gap-2 rounded-lg border border-slate-200/60 bg-white/60 px-3 py-2 shadow-sm dark:border-slate-800 dark:bg-slate-900/60"><span class="oods-text text-slate-500 dark:text-slate-400" data-oods-component="Text" data-size="sm" data-weight="regular">Status</span><span class="oods-badge" data-oods-component="Badge" data-status="active" data-domain="user" data-tone="success" data-emphasis="solid" title="Active and in use." style="--cmp-badge-background:var(--sys-status-success-surface);--cmp-badge-border:var(--sys-status-success-border);--cmp-badge-text:var(--sys-status-success-text)"><span class="oods-badge__icon" aria-hidden="true"><svg width="1em" height="1em" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3.5 8.5l3 3 6-7"></path></svg></span><span class="oods-badge__label">Active</span></span></div></div><div data-extension-id="Taggable:page-header:tag-list" data-extension-type="section" data-extension-region="pageHeader" data-extension-trait="Taggable" style="display:contents"><div class="flex flex-wrap items-center gap-2 rounded-lg border border-slate-200/60 bg-white/60 px-3 py-2 shadow-sm dark:border-slate-800 dark:bg-slate-900/60"><span class="oods-text text-slate-500 dark:text-slate-400" data-oods-component="Text" data-size="sm" data-weight="regular">Tags</span><span class="oods-badge" data-oods-component="Badge" data-domain="subscription" data-tone="neutral" data-emphasis="subtle" style="--cmp-badge-background:var(--sys-status-neutral-surface);--cmp-badge-border:var(--sys-status-neutral-border);--cmp-badge-text:var(--sys-status-neutral-text)"><span class="oods-badge__label">#admin</span></span><span class="oods-badge" data-oods-component="Badge" data-domain="subscription" data-tone="neutral" data-emphasis="subtle" style="--cmp-badge-background:var(--sys-status-neutral-surface);--cmp-badge-border:var(--sys-status-neutral-border);--cmp-badge-text:var(--sys-status-neutral-text)"><span class="oods-badge__label">#beta_tester</span></span><span class="oods-badge" data-oods-component="Badge" data-domain="subscription" data-tone="neutral" data-emphasis="subtle" style="--cmp-badge-background:var(--sys-status-neutral-surface);--cmp-badge-border:var(--sys-status-neutral-border);--cmp-badge-text:var(--sys-status-neutral-text)"><span class="oods-badge__label">#vip</span></span></div></div>"`;


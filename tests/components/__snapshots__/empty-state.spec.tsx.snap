  style="--empty-state-padding: var(--sys-stack-xl); --empty-state-padding-mobile: var(--sys-inset-md); --empty-state-max-width: 36rem; --empty-state-gap: var(--sys-stack-md); --empty-state-content-gap: var(--sys-stack-sm); --empty-state-illustration-gap: var(--sys-stack-md); --empty-state-illustration-max-width: 16rem; --empty-state-icon-size: 3rem; --empty-state-icon-gap: var(--sys-stack-md); --empty-state-icon-border-radius: 50%; --empty-state-icon-font-size: 1.5rem; --empty-state-icon-background: var(--sys-status-warning-surface); --empty-state-icon-foreground: var(--sys-status-warning-text); --empty-state-icon-border: var(--sys-status-warning-border); --empty-state-headline-color: var(--sys-text-primary); --empty-state-headline-font-size: var(--sys-text-scale-heading-md-font-size); --empty-state-headline-font-weight: var(--sys-text-scale-heading-md-font-weight); --empty-state-headline-line-height: var(--sys-text-scale-heading-md-line-height); --empty-state-body-color: var(--sys-text-muted); --empty-state-body-font-size: var(--sys-text-scale-body-sm-font-size); --empty-state-body-line-height: var(--sys-text-scale-body-sm-line-height); --empty-state-actions-gap: var(--sys-control-gap);"
>
